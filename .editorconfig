# Same indentation in every editor. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# WordPress Coding Standards use tabs in PHP
[*.php]
indent_style = tab
indent_size = 4

[*.{xml,xml.dist}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[{composer.json,composer.lock}]
indent_size = 4
